[Unit]
Description=Surface ownership lookups for the energy map sandbox
After=network-online.target

[Service]
Type=simple
User=propeval
Group=propeval
WorkingDirectory=/home/propeval/Energy_Infr
ExecStart=/usr/bin/python3 /home/propeval/Energy_Infr/src/surface_owners.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
